{
  "expo": {
    "name": "Cue",
    "slug": "guardian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mikolajpiech.guardian"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4869B3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "com.mikolajpiech.guardian",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4869B3",
          "dark": {
            "backgroundColor": "#171D32"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "kotlinVersion": "2.3.20"
          }
        }
      ],
      "./plugins/withCueAndroid",
      "./plugins/withSubtext",
      "expo-image",
      "expo-localization"
    ],
    "scheme": "guardian",
    "experiments": {
      "typedRoutes": true
    }
  }
}
