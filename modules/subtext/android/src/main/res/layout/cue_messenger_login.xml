<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/cue_login_root" android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:background="@color/cue_login_background">
  <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="12dp">
    <ImageButton android:id="@+id/cue_login_close" android:layout_width="48dp" android:layout_height="48dp"
      android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/cue_login_back" android:contentDescription="@string/cue_login_back" />
    <TextView android:id="@+id/cue_login_network" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
      android:text="Messenger" android:textSize="17sp" android:fontFamily="sans-serif-medium" android:textColor="@color/cue_login_text" />
  </LinearLayout>
  <LinearLayout android:id="@+id/cue_login_intro" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="12dp" android:paddingBottom="24dp">
    <TextView android:id="@+id/cue_login_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/cue_login_heading"
      android:textSize="28sp" android:fontFamily="sans-serif-medium" android:letterSpacing="-0.02" android:textColor="@color/cue_login_text" android:accessibilityHeading="true" />
    <TextView android:id="@+id/cue_login_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
      android:text="@string/cue_login_description" android:textSize="15sp" android:lineSpacingExtra="4dp" android:textColor="@color/cue_login_secondary" />
  </LinearLayout>
  <TextView android:id="@+id/cue_login_notice" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginHorizontal="24dp" android:layout_marginBottom="16dp" android:padding="12dp"
    android:textSize="14sp" android:textColor="@color/cue_login_error" android:background="@color/cue_login_error_surface"
    android:accessibilityLiveRegion="polite" android:visibility="gone" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:layout_marginHorizontal="16dp" android:orientation="vertical" android:background="@drawable/cue_login_frame" android:clipToOutline="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="4dp">
      <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/cue_login_lock" android:importantForAccessibility="no" />
      <TextView android:id="@+id/cue_login_domain" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
        android:text="facebook.com" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textColor="@color/cue_login_secondary" android:maxLines="1" android:ellipsize="end" />
      <ImageButton android:id="@+id/cue_login_reload" android:layout_width="48dp" android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/cue_login_reload" android:contentDescription="@string/cue_login_reload" />
      <ImageButton android:id="@+id/cue_login_options" android:layout_width="48dp" android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/cue_login_more" android:contentDescription="@string/cue_login_options" />
    </LinearLayout>
    <ProgressBar android:id="@+id/cue_login_progress" style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent" android:layout_height="2dp" android:indeterminate="false" android:max="100"
      android:progressTint="@color/cue_login_accent" android:progressBackgroundTint="@color/cue_login_border" />
    <FrameLayout android:id="@+id/cue_login_browser" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
      <LinearLayout android:id="@+id/cue_login_state" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:orientation="vertical" android:padding="32dp" android:background="@color/cue_login_surface">
        <ProgressBar android:id="@+id/cue_login_spinner" android:layout_width="32dp" android:layout_height="32dp" android:indeterminateTint="@color/cue_login_accent" />
        <TextView android:id="@+id/cue_login_state_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
          android:text="@string/cue_login_loading" android:textSize="18sp" android:fontFamily="sans-serif-medium" android:gravity="center" android:textColor="@color/cue_login_text" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/cue_login_state_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
          android:text="@string/cue_login_loading_detail" android:textSize="14sp" android:lineSpacingExtra="4dp" android:gravity="center" android:textColor="@color/cue_login_secondary" />
        <Button android:id="@+id/cue_login_retry" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
          android:layout_marginTop="24dp" android:padding="12dp" android:gravity="center" android:text="@string/cue_login_retry"
          android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textColor="@color/cue_login_on_accent"
          android:background="@drawable/cue_login_action" android:backgroundTint="@null" android:stateListAnimator="@null" android:textAllCaps="false" android:visibility="gone" />
      </LinearLayout>
    </FrameLayout>
  </LinearLayout>
  <TextView android:id="@+id/cue_login_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingHorizontal="24dp" android:paddingVertical="16dp" android:gravity="center"
    android:text="@string/cue_login_footer" android:textSize="12sp" android:textColor="@color/cue_login_secondary" />
</LinearLayout>
