  <string-array name="cue_hints_natural"><item>You write as usual, with no extra tone.</item></string-array>
  <string-array name="cue_hints_flirt">
    <item>Curiosity and humour, flirting between the lines.</item>
    <item>Clear, relaxed flirting with a compliment and teasing.</item>
    <item>Confident and charged. The more they reciprocate, the bolder.</item>
  </string-array>
  <string-array name="cue_hints_assertive">
    <item>Clear, but soft and polite.</item>
    <item>You calmly and clearly say what you want.</item>
    <item>Short and unambiguous, without justifying yourself.</item>
  </string-array>
  <string-array name="cue_hints_empathetic">
    <item>You briefly and kindly show understanding.</item>
    <item>You notice emotions and offer support.</item>
    <item>Very personal and fully engaged.</item>
  </string-array>
  <string-array name="cue_hints_calming">
    <item>You lower the tension neutrally and matter-of-factly.</item>
    <item>You look for agreement without accusations.</item>
    <item>You take responsibility for your part and apologise.</item>
  </string-array>
