  <color name="cue_login_surface">#202840</color>
  <color name="cue_login_text">#F7F5FF</color>
  <color name="cue_login_secondary">#B9C2DD</color>
  <color name="cue_login_border">#36405F</color>
  <color name="cue_login_accent">#A7B8FF</color>
